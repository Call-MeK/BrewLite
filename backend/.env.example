PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL is required. Set credentials for your own local database.
# DATABASE_URL format: postgresql://<username>:<password>@localhost:5432/brewlite
DATABASE_URL=

JWT_SECRET=
# Generate JWT_SECRET with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_EXPIRES_IN=3600

# Server-controlled deterministic mock; never accept the outcome from a request.
MOCK_PAYMENT_RESULT=SUCCEEDED
